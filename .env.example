# intervals.icu sync — copy to .env and fill in.
# Find both values at https://intervals.icu/settings (Developer section).
# If unset, the pipeline still runs from strava_export/ only.
INTERVALS_ICU_API_KEY=
INTERVALS_ICU_ATHLETE_ID=

# Stadia Maps API key — sign up free at https://client.stadiamaps.com/signup/
# (200k tile requests/month free tier). Without it, the unkeyed endpoint
# will hit "account limit reached" once you've browsed enough.
# Leave blank to skip the Stadia basemaps from the panel.
STADIA_API_KEY=
